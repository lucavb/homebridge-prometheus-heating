{
    "compilerOptions": {
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "noUncheckedIndexedAccess": true,
        "outDir": "dist",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022"
    },
    "include": ["src/**/*"],
    "exclude": ["src/**/*.spec.ts", "src/**/__tests__"]
}
