{
    "name": "homebridge-prometheus-heating",
    "displayName": "Homebridge Prometheus Heating",
    "version": "0.0.0-development",
    "description": "Homebridge platform: room heating controlled via Prometheus temperature metrics and Shelly relays (hysteresis or PWM).",
    "author": "lucavb",
    "license": "GPL-3.0-or-later",
    "main": "dist/index.js",
    "engines": {
        "homebridge": ">=1.8.0 || >=2.0.0",
        "node": ">=24"
    },
    "keywords": [
        "heating",
        "homebridge",
        "homebridge-plugin",
        "prometheus",
        "shelly",
        "thermostat"
    ],
    "files": [
        "dist",
        "config.schema.json"
    ],
    "scripts": {
        "build": "tsc",
        "clean": "rimraf dist",
        "dev": "npm run build && homebridge -I -D",
        "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.md\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.md\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@commitlint/cli": "20.4.1",
        "@commitlint/config-conventional": "20.4.1",
        "@eslint/js": "10.0.1",
        "@semantic-release/commit-analyzer": "13.0.1",
        "@semantic-release/github": "12.0.6",
        "@semantic-release/npm": "13.1.4",
        "@semantic-release/release-notes-generator": "14.1.0",
        "@types/node": "24.10.13",
        "@vitest/coverage-v8": "4.0.18",
        "eslint": "10.0.0",
        "homebridge": "1.11.2",
        "prettier": "3.8.1",
        "rimraf": "6.1.3",
        "semantic-release": "25.0.3",
        "typescript": "5.9.3",
        "typescript-eslint": "8.56.0",
        "vitest": "4.0.18"
    },
    "peerDependencies": {
        "homebridge": ">=1.8.0 || >=2.0.0"
    }
}
